{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://busbuddy-api.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
